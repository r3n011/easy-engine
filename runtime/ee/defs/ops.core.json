{
  "extension": "ee.core",
  "extensionVersion": 1,
  "description": "Easy Engine 核心 op：调度器与 IR 求值器认识的最小指令集。扩展通过新增 ops.<扩展id>.json 注入。",
  "ops": [
    {"id": "event.hat", "yields": false, "pure": false, "args": ["kind", "params"]},
    {"id": "event.broadcast", "yields": false, "pure": false, "args": ["message"]},
    {"id": "event.broadcast_wait", "yields": true, "pure": false, "args": ["message"]},
    {"id": "control.repeat", "yields": true, "pure": false, "args": ["times", "body"]},
    {"id": "control.forever", "yields": true, "pure": false, "args": ["body"]},
    {"id": "control.while", "yields": true, "pure": false, "args": ["cond", "body"]},
    {"id": "control.if", "yields": false, "pure": false, "args": ["cond", "body"]},
    {"id": "control.if_else", "yields": false, "pure": false, "args": ["cond", "then", "else"]},
    {"id": "control.wait", "yields": true, "pure": false, "args": ["seconds"]},
    {"id": "control.wait_until", "yields": true, "pure": false, "args": ["cond"]},
    {"id": "control.stop", "yields": false, "pure": false, "args": ["mode"]},
    {"id": "control.stop_all", "yields": false, "pure": false, "args": []},
    {"id": "control.clone_create", "yields": false, "pure": false, "args": ["target"]},
    {"id": "control.clone_delete", "yields": false, "pure": false, "args": ["target"]},
    {"id": "control.warp", "yields": false, "pure": false, "args": ["body"], "note": "原子执行区，内部不让步"},
    {"id": "motion.move_steps", "yields": false, "pure": false, "args": ["target", "steps"]},
    {"id": "motion.set_position", "yields": false, "pure": false, "args": ["target", "x", "y"]},
    {"id": "motion.change_x", "yields": false, "pure": false, "args": ["target", "dx"]},
    {"id": "motion.change_y", "yields": false, "pure": false, "args": ["target", "dy"]},
    {"id": "motion.set_x", "yields": false, "pure": false, "args": ["target", "x"]},
    {"id": "motion.set_y", "yields": false, "pure": false, "args": ["target", "y"]},
    {"id": "motion.point_direction", "yields": false, "pure": false, "args": ["target", "direction"]},
    {"id": "motion.turn", "yields": false, "pure": false, "args": ["target", "delta", "mode"]},
    {"id": "motion.bounce", "yields": false, "pure": false, "args": ["target"]},
    {"id": "motion.get_x", "yields": false, "pure": true, "args": ["target"]},
    {"id": "motion.get_y", "yields": false, "pure": true, "args": ["target"]},
    {"id": "motion.get_direction", "yields": false, "pure": true, "args": ["target"]},
    {"id": "looks.say", "yields": false, "pure": false, "args": ["target", "text", "mode", "seconds"]},
    {"id": "looks.set_visible", "yields": false, "pure": false, "args": ["target", "visible"]},
    {"id": "looks.set_costume", "yields": false, "pure": false, "args": ["target", "name", "mode"]},
    {"id": "looks.next_costume", "yields": false, "pure": false, "args": ["target"]},
    {"id": "looks.set_size", "yields": false, "pure": false, "args": ["target", "percent", "mode"]},
    {"id": "looks.change_size", "yields": false, "pure": false, "args": ["target", "delta"]},
    {"id": "looks.set_effect", "yields": false, "pure": false, "args": ["target", "effect", "mode", "value"]},
    {"id": "looks.change_effect", "yields": false, "pure": false, "args": ["target", "effect", "delta"]},
    {"id": "looks.clear_effects", "yields": false, "pure": false, "args": ["target"]},
    {"id": "looks.set_layer", "yields": false, "pure": false, "args": ["target", "mode", "layers"]},
    {"id": "sound.play", "yields": true, "pure": false, "args": ["target", "name", "wait"]},
    {"id": "sound.stop_all", "yields": false, "pure": false, "args": []},
    {"id": "sensing.touching", "yields": false, "pure": true, "args": ["target", "other"]},
    {"id": "sensing.key_pressed", "yields": false, "pure": true, "args": ["key"]},
    {"id": "sensing.mouse_x", "yields": false, "pure": true, "args": []},
    {"id": "sensing.mouse_y", "yields": false, "pure": true, "args": []},
    {"id": "sensing.mouse_down", "yields": false, "pure": true, "args": []},
    {"id": "sensing.timer", "yields": false, "pure": true, "args": []},
    {"id": "sensing.reset_timer", "yields": false, "pure": false, "args": []},
    {"id": "sensing.ask", "yields": true, "pure": false, "args": ["question"]},
    {"id": "sensing.answer", "yields": false, "pure": true, "args": []},
    {"id": "op.add", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.sub", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.mul", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.div", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.mod", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.round", "yields": false, "pure": true, "args": ["value"]},
    {"id": "op.abs", "yields": false, "pure": true, "args": ["value"]},
    {"id": "op.random", "yields": false, "pure": false, "args": ["from", "to"]},
    {"id": "op.gt", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.lt", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.eq", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.and", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.or", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.not", "yields": false, "pure": true, "args": ["value"]},
    {"id": "op.join", "yields": false, "pure": true, "args": ["left", "right"]},
    {"id": "op.letter_of", "yields": false, "pure": true, "args": ["index", "string"]},
    {"id": "op.length", "yields": false, "pure": true, "args": ["string"]},
    {"id": "op.contains", "yields": false, "pure": true, "args": ["string", "needle"]},
    {"id": "op.expression", "yields": false, "pure": true, "args": ["source"], "note": "逃生舱①：表达式输入框"},
    {"id": "var.get", "yields": false, "pure": true, "args": ["name", "scope"], "defaults": {"scope": "auto"}},
    {"id": "var.set", "yields": false, "pure": false, "args": ["name", "value", "scope"], "defaults": {"scope": "auto"}},
    {"id": "var.change", "yields": false, "pure": false, "args": ["name", "delta", "scope"], "defaults": {"scope": "auto"}},
    {"id": "var.show", "yields": false, "pure": false, "args": ["name", "scope", "show"], "defaults": {"scope": "auto"}},
    {"id": "list.add", "yields": false, "pure": false, "args": ["name", "value", "scope"], "defaults": {"scope": "auto"}},
    {"id": "list.delete", "yields": false, "pure": false, "args": ["name", "index", "scope"], "defaults": {"scope": "auto"}},
    {"id": "list.clear", "yields": false, "pure": false, "args": ["name", "scope"], "defaults": {"scope": "auto"}},
    {"id": "list.insert", "yields": false, "pure": false, "args": ["name", "index", "value", "scope"], "defaults": {"scope": "auto"}},
    {"id": "list.replace", "yields": false, "pure": false, "args": ["name", "index", "value", "scope"], "defaults": {"scope": "auto"}},
    {"id": "list.get", "yields": false, "pure": true, "args": ["name", "index", "scope"], "defaults": {"scope": "auto"}},
    {"id": "list.length", "yields": false, "pure": true, "args": ["name", "scope"], "defaults": {"scope": "auto"}},
    {"id": "list.index_of", "yields": false, "pure": true, "args": ["name", "value", "scope"], "defaults": {"scope": "auto"}},
    {"id": "list.contains", "yields": false, "pure": true, "args": ["name", "value", "scope"], "defaults": {"scope": "auto"}},
    {"id": "list.show", "yields": false, "pure": false, "args": ["name", "scope", "show"], "defaults": {"scope": "auto"}},
    {"id": "meta.set_property", "yields": false, "pure": false, "args": ["target", "property", "value"]},
    {"id": "meta.get_property", "yields": false, "pure": true, "args": ["target", "property"]},
    {"id": "meta.call_method", "yields": false, "pure": false, "args": ["target", "method", "args"]},
    {"id": "meta.emit_signal", "yields": false, "pure": false, "args": ["target", "signal", "args"]},
    {"id": "meta.instantiate", "yields": false, "pure": false, "args": ["parent", "source"]},
    {"id": "code.gdscript", "yields": true, "pure": false, "args": ["target", "source"], "note": "逃生舱②：代码块"}
  ]
}
