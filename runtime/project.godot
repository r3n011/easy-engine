; Easy Engine 运行时（M1：项目格式 / IR / 编译器）
;
; 这不是游戏项目，而是"数据模型与编译管线"的宿主。
; 用 --headless --script 方式跑验收工具。

config_version=5

[application]

config/name="Easy Engine"
config/description="用积木做游戏：Godot 作内核，Scratch 积木作编程方式"
config/features=PackedStringArray("4.7")
run/main_scene="res://editor/editor.tscn"
boot_splash/image="res://brand/icon.png"
boot_splash/bg_color=Color(0.06, 0.07, 0.1, 1)
config/icon="res://brand/icon.png"

[debug]

; 运行时代码是动态的（IR 是字典树、值可能是任意 Variant），
; 这几条静态检查在这里只会制造噪音，关掉。
gdscript/warnings/untyped_declaration=0
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/unsafe_void_return=0
gdscript/warnings/unused_parameter=0

[rendering]

renderer/rendering_method="gl_compatibility"
