# ---- 第三方源码：不入库，用 bootstrap.ps1 拉取 ----
/engine/
/scratch/

# bootstrap.ps1 会自动下载
/tools/vswhere.exe

# API 数据转储（本地分析用，可随时用 --dump-extension-api 重建）
/datadump/

# 验证套件运行时从 engine/ 拷贝的翻译文件
/tools/verify-translation/*.po
/tools/verify-translation/project.godot

# ---- 构建产物 ----
/bin/
/obj/
*.obj
*.pdb
*.ilk
*.lib
*.exp
/backup/

# ---- 临时与备份 ----
*.bak
*.tmp
*.log

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
# Godot 运行项目时生成的缓存
.godot/
Thumbs.db
desktop.ini
.DS_Store

# Godot 打开工程时给素材生成的导入文件（本项目通过 Image.load 直接读，
# 不依赖导入流程；这些文件由编辑器随时重建）
*.import
# 模块构建时生成的定义头（由 tools/gen_defs.py 产生）
modules/easyblocks/block_defs.gen.h
modules/easyblocks/**/__pycache__/
